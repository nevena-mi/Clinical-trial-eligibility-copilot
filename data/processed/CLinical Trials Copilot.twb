      <aliases enabled='yes' />
      <column caption='Trials per patient' datatype='integer' name='[Calculation_3597847744339968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [patient_id] : COUNTD([trial_id]) }' />
      </column>
      <column caption='Baseline agreement %' datatype='real' name='[Calculation_3597847747547137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([baseline_agreement_flag])' />
      </column>
      <column caption='Baseline unsafe MET %' datatype='real' name='[Calculation_3597847748444162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([ground_truth_label] = &quot;NOT_MET&quot; AND [baseline_label] = &quot;MET&quot;, 1, 0))&#10;/&#10;SUM(IIF([ground_truth_label] = &quot;NOT_MET&quot;, 1, 0))' />
      </column>
      <column caption='Baseline UNKNOWN recall %' datatype='real' name='[Calculation_3597847748829187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([ground_truth_label] = &quot;UNKNOWN&quot; AND [baseline_label] = &quot;UNKNOWN&quot;, 1, 0))&#10;/&#10;SUM(IIF([ground_truth_label] = &quot;UNKNOWN&quot;, 1, 0))' />
      </column>
