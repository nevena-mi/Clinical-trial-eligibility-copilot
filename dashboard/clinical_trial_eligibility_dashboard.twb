      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:ground_truth_label:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;MET&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;NOT_APPLICABLE&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;UNKNOWN&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;NOT_MET&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:criterion_type:nk]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;inclusion&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;exclusion&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:explanation_correctness:nk]' type='palette'>
            <map to='#6eb663'>
              <bucket>&quot;Correct&quot;</bucket>
            </map>
            <map to='#ca223c'>
              <bucket>&quot;Incorrect&quot;</bucket>
            </map>
            <map to='#f07e27'>
              <bucket>&quot;Partially Correct&quot;</bucket>
